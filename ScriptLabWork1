-- Создание таблицы ролей
CREATE TABLE Roles (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Name NVARCHAR(50) NOT NULL UNIQUE
);

-- Заполнение ролями
INSERT INTO Roles (Name) VALUES ('Студент'), ('Учитель');

-- Создание таблицы пользователей
CREATE TABLE Users (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Username NVARCHAR(100) NOT NULL UNIQUE,
    Email NVARCHAR(255) NOT NULL UNIQUE,
    UserPassword NVARCHAR(100) NOT NULL,
    RoleId INT NOT NULL,
    CONSTRAINT FK_Users_Roles FOREIGN KEY (RoleId) REFERENCES Roles(Id)
);

-- Создание таблицы материалов
CREATE TABLE Materials (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Title NVARCHAR(255) NOT NULL,
    Description NVARCHAR(MAX),
    FilePath NVARCHAR(500) NOT NULL,
    UploadedById INT NOT NULL,
    CONSTRAINT FK_Materials_Users FOREIGN KEY (UploadedById) REFERENCES Users(Id)
);

-- Создание таблицы прогресса по материалам
CREATE TABLE MaterialProgress (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    UserId INT NOT NULL,
    MaterialId INT NOT NULL,
    TimeSpentSeconds INT DEFAULT 0,
    CONSTRAINT FK_MaterialProgress_Users FOREIGN KEY (UserId) REFERENCES Users(Id),
    CONSTRAINT FK_MaterialProgress_Materials FOREIGN KEY (MaterialId) REFERENCES Materials(Id)
);

-- Создание таблицы тем тестов
CREATE TABLE TestTopics (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    Title NVARCHAR(255) NOT NULL,
    Description NVARCHAR(MAX)
);

-- Заполнение темы теста
INSERT INTO TestTopics (Title, Description) 
VALUES ('Как познакомиться с девушкой', 'Тест по теме знакомства с девушками');

-- Создание таблицы вопросов
CREATE TABLE Questions (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    TopicId INT NOT NULL,
    Text NVARCHAR(MAX) NOT NULL,
    CreatedById INT NOT NULL,
    CONSTRAINT FK_Questions_TestTopics FOREIGN KEY (TopicId) REFERENCES TestTopics(Id),
    CONSTRAINT FK_Questions_Users FOREIGN KEY (CreatedById) REFERENCES Users(Id)
);

-- Создание таблицы ответов
CREATE TABLE Answers (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    QuestionId INT NOT NULL,
    Text NVARCHAR(MAX) NOT NULL,
    IsCorrect BIT NOT NULL DEFAULT 0,
    CONSTRAINT FK_Answers_Questions FOREIGN KEY (QuestionId) REFERENCES Questions(Id)
);

-- Создание таблицы результатов тестов
CREATE TABLE TestResults (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    UserId INT NOT NULL,
    TopicId INT NOT NULL,
    Score INT NOT NULL,
    Percentage DECIMAL(5,2) NOT NULL,
    CompletedAt DATETIME2 NOT NULL DEFAULT GETDATE(),
    CONSTRAINT FK_TestResults_Users FOREIGN KEY (UserId) REFERENCES Users(Id),
    CONSTRAINT FK_TestResults_TestTopics FOREIGN KEY (TopicId) REFERENCES TestTopics(Id)
);

